# CareerHub AI — Monorepo Master Environment Template
# Copy this file to .env in workspace root or respective app directories.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/careerhub?retryWrites=true&w=majority

JWT_SECRET=super_secret_jwt_key_careerhub_ai_32chars
JWT_REFRESH_SECRET=super_secret_refresh_key_careerhub_ai_32chars

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@careerhub.ai
SMTP_PASS=your_smtp_app_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

GEMINI_API_KEY=your_gemini_api_key
