{
  "name": "@careerhub/server",
  "version": "1.0.0",
  "private": true,
  "description": "CareerHub AI — Node.js/Express/MongoDB Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist",
    "test": "tsx src/tests/run.ts"
  },
  "dependencies": {
    "@careerhub/shared": "*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.3.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.0",
    "puppeteer": "^25.5.0",
    "socket.io": "^4.7.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "rimraf": "^5.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
