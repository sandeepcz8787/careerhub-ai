# =============================================================================
# CareerHub AI — Server Environment Variables
# =============================================================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=CareerHub AI
APP_URL=http://localhost:5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication & JWT
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_ACCESS_SECRET=your_access_token_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Nodemailer / Brevo)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_PASSWORD=your_smtp_app_password
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_NAME=CareerHub AI
EMAIL_FROM_ADDRESS=noreply@careerhub.ai

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/v1/auth/linkedin/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# AI Service (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
COOKIE_SECRET=your_cookie_secret_min_32_characters_here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
